{
  "title": "RailLab session v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionVersion": {
      "type": "string",
      "const": "1"
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "anchor": {
          "type": "object",
          "properties": {
            "assetCode": {
              "default": "USDC",
              "type": "string",
              "pattern": "^[A-Za-z0-9]{1,12}$"
            },
            "amountIn": {
              "default": "100",
              "type": "string",
              "pattern": "^\\d+(\\.\\d{1,7})?$"
            },
            "fee": {
              "default": "1",
              "type": "string",
              "pattern": "^\\d+(\\.\\d{1,7})?$"
            },
            "timeline": {
              "minItems": 2,
              "maxItems": 40,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "atMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 604800000
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "incomplete",
                      "pending_user_transfer_start",
                      "pending_user_transfer_complete",
                      "pending_external",
                      "pending_anchor",
                      "pending_stellar",
                      "pending_trust",
                      "pending_user",
                      "completed",
                      "refunded",
                      "expired",
                      "no_market",
                      "too_small",
                      "too_large",
                      "error"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "required": [
                  "atMs",
                  "status"
                ],
                "additionalProperties": false
              }
            },
            "jitterMs": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 604800000
            }
          },
          "required": [
            "timeline"
          ],
          "additionalProperties": false
        },
        "requestIntervalMs": {
          "default": 5000,
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "faults": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "transient_error"
                  },
                  "status": {
                    "default": 503,
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 500
                      },
                      {
                        "type": "number",
                        "const": 502
                      },
                      {
                        "type": "number",
                        "const": 503
                      },
                      {
                        "type": "number",
                        "const": 504
                      }
                    ]
                  },
                  "retryAfterSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600
                  },
                  "onPolls": {
                    "minItems": 1,
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000
                    }
                  },
                  "fromMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 604800000
                  },
                  "toMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 604800000
                  },
                  "probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "duplicate_response"
                  },
                  "onPolls": {
                    "minItems": 1,
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000
                    }
                  },
                  "fromMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 604800000
                  },
                  "toMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 604800000
                  },
                  "probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "stale_snapshot"
                  },
                  "serveAsOfMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 604800000
                  },
                  "onPolls": {
                    "minItems": 1,
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000
                    }
                  },
                  "fromMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 604800000
                  },
                  "toMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 604800000
                  },
                  "probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "type",
                  "serveAsOfMs"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "latency"
                  },
                  "virtualMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 604800000
                  },
                  "realMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "onPolls": {
                    "minItems": 1,
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000
                    }
                  },
                  "fromMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 604800000
                  },
                  "toMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 604800000
                  },
                  "probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "type",
                  "virtualMs"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "mismatched_reference"
                  },
                  "onPolls": {
                    "minItems": 1,
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000
                    }
                  },
                  "fromMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 604800000
                  },
                  "toMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 604800000
                  },
                  "probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "token_expiry"
                  },
                  "afterMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 604800000
                  }
                },
                "required": [
                  "type",
                  "afterMs"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "maxPolls": {
          "default": 60,
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "schemaVersion",
        "name",
        "title",
        "description",
        "anchor"
      ],
      "additionalProperties": false
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "consumer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "reference",
            "external"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "additionalProperties": false
    },
    "endedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "consumerError": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "sep",
                  "policy"
                ]
              },
              "basis": {
                "type": "string"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "not_applicable",
                  "inconclusive"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "title",
              "kind",
              "basis",
              "outcome",
              "evidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "verdict",
        "assertions"
      ],
      "additionalProperties": false
    },
    "timeline": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "request"
              },
              "seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "atMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "n": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "pollIndex": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "httpStatus": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "faults": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                }
              },
              "anchorStatus": {
                "type": "string",
                "enum": [
                  "incomplete",
                  "pending_user_transfer_start",
                  "pending_user_transfer_complete",
                  "pending_external",
                  "pending_anchor",
                  "pending_stellar",
                  "pending_trust",
                  "pending_user",
                  "completed",
                  "refunded",
                  "expired",
                  "no_market",
                  "too_small",
                  "too_large",
                  "error"
                ]
              },
              "servedStatus": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "incomplete",
                      "pending_user_transfer_start",
                      "pending_user_transfer_complete",
                      "pending_external",
                      "pending_anchor",
                      "pending_stellar",
                      "pending_trust",
                      "pending_user",
                      "completed",
                      "refunded",
                      "expired",
                      "no_market",
                      "too_small",
                      "too_large",
                      "error"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "servedId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "servedRank": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reordered": {
                "type": "boolean"
              },
              "duplicate": {
                "type": "boolean"
              },
              "mismatchedId": {
                "type": "boolean"
              },
              "authFailure": {
                "type": "boolean"
              },
              "digest": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "seq",
              "atMs",
              "n",
              "pollIndex",
              "method",
              "path",
              "httpStatus",
              "faults",
              "anchorStatus",
              "servedStatus",
              "servedId",
              "servedRank",
              "reordered",
              "duplicate",
              "mismatchedId",
              "authFailure",
              "digest"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "anchor_transition"
              },
              "seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "atMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "from": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "incomplete",
                      "pending_user_transfer_start",
                      "pending_user_transfer_complete",
                      "pending_external",
                      "pending_anchor",
                      "pending_stellar",
                      "pending_trust",
                      "pending_user",
                      "completed",
                      "refunded",
                      "expired",
                      "no_market",
                      "too_small",
                      "too_large",
                      "error"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "to": {
                "type": "string",
                "enum": [
                  "incomplete",
                  "pending_user_transfer_start",
                  "pending_user_transfer_complete",
                  "pending_external",
                  "pending_anchor",
                  "pending_stellar",
                  "pending_trust",
                  "pending_user",
                  "completed",
                  "refunded",
                  "expired",
                  "no_market",
                  "too_small",
                  "too_large",
                  "error"
                ]
              }
            },
            "required": [
              "kind",
              "seq",
              "atMs",
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "consumer"
              },
              "seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "atMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "event": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "event": {
                        "type": "string",
                        "const": "status_applied"
                      },
                      "pollIndex": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "txId": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "incomplete",
                          "pending_user_transfer_start",
                          "pending_user_transfer_complete",
                          "pending_external",
                          "pending_anchor",
                          "pending_stellar",
                          "pending_trust",
                          "pending_user",
                          "completed",
                          "refunded",
                          "expired",
                          "no_market",
                          "too_small",
                          "too_large",
                          "error"
                        ]
                      }
                    },
                    "required": [
                      "event",
                      "pollIndex",
                      "txId",
                      "status"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "event": {
                        "type": "string",
                        "const": "user_status"
                      },
                      "txId": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "pending",
                          "completed",
                          "failed",
                          "unknown"
                        ]
                      },
                      "pollIndex": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "event",
                      "txId",
                      "status"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "event": {
                        "type": "string",
                        "const": "business_action"
                      },
                      "txId": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "action": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                      },
                      "key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "event",
                      "txId",
                      "action",
                      "key"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "event": {
                        "type": "string",
                        "const": "response_ignored"
                      },
                      "pollIndex": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "reason": {
                        "type": "string",
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "event",
                      "pollIndex",
                      "reason"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "event": {
                        "type": "string",
                        "const": "auth_refreshed"
                      }
                    },
                    "required": [
                      "event"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "event": {
                        "type": "string",
                        "const": "gave_up"
                      },
                      "reason": {
                        "type": "string",
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "event",
                      "reason"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "kind",
              "seq",
              "atMs",
              "event"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "timelineDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "simulationNotice": {
      "type": "string"
    }
  },
  "required": [
    "sessionVersion",
    "tool",
    "scenario",
    "seed",
    "consumer",
    "endedAtMs",
    "consumerError",
    "result",
    "timeline",
    "timelineDigest",
    "simulationNotice"
  ],
  "additionalProperties": false
}
